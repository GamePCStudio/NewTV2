<?xml version="1.0" encoding="utf-8"?>
<!--
  分类导航条「当前页 + 聚焦」胶囊底：纯白实底 + 1.5dp 白色描边。
  与非当前页的焦点描边同宽，保证焦点在两类胶囊间横移时描边重量一致；
  文字由 selector_type_text 在选中态下给纯黑。
  几何沿用 28dp 圆角 / 14+8dp 内边距。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/white" />

    <corners android:radius="28dp" />

    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/white" />

</shape>
