<?xml version="1.0" encoding="utf-8"?>
<!--
  海报图片容器的触控前景：按下出 20% 白底，无白描边；
  常态全透明。TV 的聚焦描边与 1.04 倍缩放已不在 Pad 使用。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">

    <item android:drawable="@drawable/shape_vod_pressed" android:state_pressed="true" />
    <item android:drawable="@drawable/shape_vod_unfocused" />

</selector>
