<?xml version="1.0" encoding="utf-8"?>
<!-- 胶囊内的图标按钮：常态透明，按下时 30% 白底胶囊，无白描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/shape_pill_pressed" android:state_pressed="true" />

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pad_pill_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
