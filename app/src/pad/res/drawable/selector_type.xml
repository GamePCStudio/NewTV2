<?xml version="1.0" encoding="utf-8"?>
<!--
  分类导航条 / 筛选子项的 Pad 触控状态表：
    禁用            → 20% 透明黑实底；
    按下 + 当前项   → 纯白底（保持当前页黑字）；
    当前项          → 60% 透明白底；
    按下            → 30% 白底；
    常态            → #1D1F23 实底。
  状态优先级自上而下；文字 / 图标颜色由 @color/selector_type_text 按同一状态表驱动。
  无 focus/hover 分支，也不画白色描边。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/shape_type_disabled" android:state_enabled="false" />
    <item android:drawable="@drawable/shape_pad_selected" android:state_pressed="true" android:state_selected="true" />
    <item android:drawable="@drawable/shape_type_selected" android:state_selected="true" />
    <item android:drawable="@drawable/shape_pill_pressed" android:state_pressed="true" />
    <item android:drawable="@drawable/shape_type_normal" />

</selector>
