<?xml version="1.0" encoding="utf-8"?>
<!--
  分类导航条 / 筛选子项 / 筛选图标共用的文字与图标色（Pad），
  与 @drawable/selector_type 的状态顺序一一对应：
    禁用   → 40% 透明白；
    当前页 → 黑（60% 透明白底上仍可读）；
    常态   → 白。
  按下态由底色表达，文字不变；无 focus/hover 分支。
  ic_vod_filter_on/off 的 tint 也引用本选择器，图标与文字同步切换。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/white_40" android:state_enabled="false" />
    <item android:color="@color/black" android:state_selected="true" />
    <item android:color="@color/white" />
</selector>
