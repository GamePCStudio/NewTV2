<?xml version="1.0" encoding="utf-8"?>
<!--
  分类导航条专用状态底（mobile，仅 adapter_type.xml 使用）：
    当前页 + 聚焦     → 纯白实底 + 白描边（shape_type_focused），文字黑；
    当前页 + 未聚焦   → 60% 透明白（shape_type_selected），文字黑；
    其余（含非当前页焦点）→ #1D1F23（shape_type_normal），文字白。

  作为 shape_type_chip 这个 ripple 的 content 使用，按压涟漪因此保留。
  顺序不可调换：两条 state_selected 必须排在默认项之前。
  与 TV 端 selector_type 完全独立，互不影响。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/shape_type_focused" android:state_focused="true" android:state_selected="true" />
    <item android:drawable="@drawable/shape_type_selected" android:state_selected="true" />
    <item android:drawable="@drawable/shape_type_normal" />

</selector>
