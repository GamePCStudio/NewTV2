<?xml version="1.0" encoding="utf-8"?>
<!--
  分类导航条专用胶囊（mobile）：沿用 shape_item_round 的 28dp 圆角与 12/6dp 内边距，
  并把底色换成 selector_type_chip_bg；保留系统 ripple 作为按压反馈。
  搜索记录 / 热词 chip 仍使用原 shape_item_round，不受影响。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/selector_type_chip_bg" />
            <corners android:radius="28dp" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
