<?xml version="1.0" encoding="utf-8"?>
<!--
  触控令牌的编译期默认值，供共用 Java（Product）在所有变体下引用。
  pad 变体的 src/pad/res/values/dimens.xml 会覆盖这些值；
  leanback/mobile 保持 TV 口径（列数 4、间距 20dp、安全区 48dp）。
-->
<resources>
    <integer name="pad_poster_columns">4</integer>
    <dimen name="pad_poster_columns_spacing">20dp</dimen>
    <dimen name="pad_page_margin">48dp</dimen>
</resources>
