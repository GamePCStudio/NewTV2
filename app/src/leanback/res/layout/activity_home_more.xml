<?xml version="1.0" encoding="utf-8"?>
<!--
  「更多影片」页：左上角是当前分类标题（24sp），下方是与分类页同款的海报网格
  （左右 48dp 安全区、列距 20dp、行距 8dp，尺寸全部走 Product.getSpec）。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp"
        android:paddingBottom="12dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_title"
        tools:text="TMDB·今日电影" />

    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.fongmi.android.tv.ui.custom.CustomVerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true"
            app:focusOutSideEnd="false"
            app:focusOutSideStart="false" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
