<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <!--
      两个时间文字上的 translationY=0.5dp 是常态「行高补偿」，不是视觉间距：
      LeanbackTimeBar 默认在测量高度上方追加 1dp（HEAT_EXTRA_DP），本行 wrap_content +
      center_vertical，行高 26dp→27dp，居中文字被抬高 0.5dp，这里补回半增量。
      竖向空间不足时 LeanbackTimeBar 会整体扩容到 150%，并在 onMeasure 里按实际增量
      动态改写这两个文字的 translationY，因此这里的值只是常态基线，不必手动同步。
      用 translationY 而不是 layout_marginTop：平移不参与测量，位移量就是字面值。
    -->

    <TextView
        android:id="@id/exo_position"
        style="@style/ExoStyledControls.TimeText.Position"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="0dp"
        android:translationY="0.5dp" />

    <com.fongmi.android.tv.ui.custom.LeanbackTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/exo_progress"
        android:nextFocusRight="@id/exo_progress" />

    <TextView
        android:id="@id/exo_duration"
        style="@style/ExoStyledControls.TimeText.Position"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="0dp"
        android:translationY="0.5dp" />

</LinearLayout>
