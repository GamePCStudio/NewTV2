<?xml version="1.0" encoding="utf-8"?>
<!--
  首页分层（FrameLayout 的子 View 顺序即绘制顺序，后画的压在先画的之上；

    L-1 pageGlow（无 elevation，最底层）整页背景漫反射：焦点卡主色驱动的
        全屏柔光，画在所有内容之下、盖在 windowBackground 之上；不参与焦点与点击。
  再用 elevation 显式拉开 Z 序，避免 recycler 内部聚焦 item / 系统焦点高亮抢到上层）：

    L0  ProgressLayout → VerticalGridView
        主视觉 + 全部内容行。
    L1  topScrim（无 elevation，靠绘制顺序压在 recycler 之上、工具栏之下）
        顶部渐变遮罩：屏幕边缘黑 50%，向下淡出到全透明。高度由
        HomeActivity.applyTopScrim() 按「工具栏底边 + 5dp」动态设置，不遮住顶栏文字。
    L2  homeToolbar（elevation 8dp）
        屏幕顶部一条 64dp 单行工具栏（导航 16sp 加粗、垂直居中对齐、无文字投影）：
        最左是搜索圆钮（36dp 深色圆 + 白色放大镜，点击进搜索页）；
        其次 2 个导航文字按钮（首页 / 片库）；
        右侧依次是 站源下拉入口 → 设置图标（白色线条，替代「我的」）→ 时钟。
    L3  siteSheet（elevation 16dp，最后一个子 View）
        FocusTrapFrameLayout：显示期间把方向焦点搜索截断在容器内部；内容为站源列表。
        原品牌入口的功能 sheet（moreSheet）已随 logo 弹窗菜单一并移除。
    L4  splashBrand（elevation 32dp）
        启动画面 banner：静态显示 640×360（原始 1280×720 的 50%）等比居中，
        约 600ms 后自动淡出隐藏。

  层级保证：sheet > toolbar > topScrim > recycler。浮层控件全部叠加在主视觉之上，
  不占用列表行。toolbar/sheet 是 ProgressLayout 的兄弟节点，因此
  ProgressLayout.showProgress() 隐藏 recycler 时不会把它们一起隐藏。
-->
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- L-1：整页背景漫反射（焦点卡主色驱动，画在所有内容之下）。不参与焦点与点击。 -->
    <FrameLayout
        android:id="@+id/pageGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- L-0：主视觉背景层（剧照轮换）。固定在页面顶部、不随列表滚动；
         显隐由 HomeActivity 按焦点控制（顶栏 / 主视觉 / 最近观看可见，其余隐藏）。
         放在 recycler 之下：主视觉行的 item 背景已改为透明，剧照才能透上来。
         marginTop=0：剧照顶部与屏幕顶对齐，不再用负 margin 把顶部顶出屏幕。 -->
    <com.fongmi.android.tv.ui.custom.HomeHeroBackdropView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="0dp" />

    <!-- L0：列表内容（主视觉是它的第 0 行） -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- L0.5：「最近观看」的悬浮片名（页面级，不随列表滚动）。
         焦点停在「最近观看」行内时显示，离开即淡出；水平贴屏幕左侧内容边距，
         竖直由代码贴到该行标题容器的上沿之上（间距 26dp），尺寸约束与主视觉
         titleBox 同源（高 120dp、宽不超过 300dp、fitCenter）。
         focusable/clickable 全关，不参与焦点与点击，纯粹是一层视觉。

         外层 anchor 只负责 Y 定位（滚动时逐帧 setY），内层 historyLogo 只负责
         alpha / translationY 动画 —— 两者分开，滚动纠偏不会打断入场动画。 -->
    <FrameLayout
        android:id="@+id/historyLogoAnchor"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:clickable="false"
        android:clipChildren="false"
        android:focusable="false"
        android:importantForAccessibility="no">

        <FrameLayout
            android:id="@+id/historyLogo"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:alpha="0"
            android:clipChildren="false"
            android:importantForAccessibility="no"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/historyLogoImage"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_gravity="bottom|start"
                android:scaleType="fitCenter"
                android:visibility="invisible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/historyLogoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:maxWidth="300dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                android:visibility="invisible" />
        </FrameLayout>
    </FrameLayout>

    <!-- L1：顶部渐变遮罩（高度由代码设置；不参与焦点与点击） -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_gravity="top"
        android:background="@drawable/shape_top_scrim"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- L2：顶部工具栏（可复用布局 view_home_toolbar.xml，与分类页共用同一份样式） -->
    <include
        android:id="@+id/homeToolbar"
        layout="@layout/view_home_toolbar" />

    <!-- L3-a：站源下拉面板（可复用布局 view_site_sheet.xml，与首页 / 分类页共用） -->
    <include
        android:id="@+id/siteSheet"
        layout="@layout/view_site_sheet" />

    <!-- L4：欢迎页（静态品牌图 splash_brand.png 1920×1080，等比居中、
         不足铺满时同色 #0C1219 补边），约 600ms 后自动淡出隐藏；
         不参与焦点与点击，elevation 最高。 -->
    <com.fongmi.android.tv.ui.custom.SplashBrandView
        android:id="@+id/splashBrand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="false"
        android:importantForAccessibility="no" />

</FrameLayout>
