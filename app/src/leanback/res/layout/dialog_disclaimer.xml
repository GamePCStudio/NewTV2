<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_disclaimer"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="28dp"
    android:paddingEnd="36dp"
    android:paddingBottom="26dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/declarationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diag_disclaimer_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/declarationScroll"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="16dp"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/declarationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="7dp"
            android:text="@string/diag_disclaimer_body"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

    </ScrollView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/declarationDecline"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="@drawable/selector_disclaimer_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/diag_disclaimer_decline"
            android:textColor="@color/selector_disclaimer_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="不同意，退出" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/declarationAgree"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/selector_disclaimer_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/diag_disclaimer_agree"
            android:textColor="@color/selector_disclaimer_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="同意" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
