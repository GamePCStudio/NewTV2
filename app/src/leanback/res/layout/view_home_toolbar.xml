<?xml version="1.0" encoding="utf-8"?>
<!--
  首页顶部工具栏（可复用组件）：首页与分类页（VodActivity）共用这一份布局，
  <b>样式 / 布局只在这里维护</b>，改这里两个页面同时生效。

  引用方式：<include android:id="@+id/homeToolbar" layout="@layout/view_home_toolbar" />
    - include 不覆盖 layout_width / layout_height，宿主按本文件根节点的参数
      （match_parent × 64dp、layout_gravity=top、marginTop=16dp）布局；
    - 宿主必须存在 id 为 recycler 的可聚焦列表，工具栏各控件的 nextFocusDown 指向它。

  结构（单行，行高 64dp）：
    搜索圆钮（放大镜）→ 2 个导航按钮（首页 / 片库）
    → 弹性空白 → 站源下拉入口 → 设置图标 → 时钟。

  <b>尺寸口径</b>：导航与站源名 16sp 加粗，时钟 18sp；
  导航选中框 / 搜索圆钮 / 站源入口 统一 36dp 高，焦点胶囊圆角 18dp（= 半高）。
  搜索圆钮与「首页」的列间距 18dp（上一版 12dp 的 150%），让「搜索」与频道导航分成两簇。

  <b>选中态</b>：聚焦 = 纯白胶囊 + 黑字；当前页未聚焦 = 60% 透明白胶囊（@color/white_60）+ 黑字；
  其余 = 全透明 + 白字。搜索圆钮同源：聚焦时圆底转纯白、放大镜转深色，与导航胶囊的取反逻辑一致。

  <b>左右基线 48dp</b>（1080p 下 96px ≈ 5% 安全区）：根节点 paddingStart/End = 48dp，
  与列表内容（recycler 同样 48dp 内边距）对齐。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeToolbar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="top"
    android:layout_marginTop="16dp"
    android:clipChildren="false"
    android:descendantFocusability="afterDescendants"
    android:elevation="8dp"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="48dp">

    <!--
      搜索圆钮：品牌位改成「放大镜」——50% 透明黑圆底（#80000000）+ 白色放大镜，点击 / 确认键进搜索页。
      尺寸 36dp 与导航选中框等高，内边距 5dp → 图标盒 26dp、可见墨迹约 19~20dp
      （ic_home_search 墨迹占 viewBox 的 80%×75%），与 16sp 文字的视觉重量相当，也与原三角 54% 的比例接近。
      焦点反馈与导航胶囊同源：圆底转纯白、放大镜转纯黑（selector_logo_bg / selector_logo_tint），
      因此不再另画描边，也不会与白色导航胶囊抢层级。
      列间距 18dp（navButtons 的 marginStart = 上一版 12dp 的 150%），把搜索与频道分成两簇。
    -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandEntry"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/selector_logo_bg"
        android:clickable="true"
        android:contentDescription="@string/home_search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/recycler"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home_search"
        android:tint="@color/selector_logo_tint" />

    <!--
      频道导航：2 个文字按钮，16sp 加粗。
      顺序即焦点顺序（未写 nextFocusLeft/Right，交给布局顺序自动串联）：
      首页 → 片库。
      「首页」是 index 0，启动 / setFocus() / 返回「回首页」都指向它。
      <b>不写 focusedByDefault</b>：默认焦点会让新页面先亮一下「首页」再跳到
      「片库」，视觉上像焦点从旧位置飞过来；改由各页在首次布局完成、绘制之前
      显式投放焦点（见 HomeActivity / VodActivity 的 installInitialFocus）。
      「片库」进 VodActivity；原「我的」已移除，设置入口改为时间左侧的设置图标（与时间互换过位置）。

      尺寸统一：固定 36dp 高（与搜索圆钮、站源入口同高）、
      最小宽 64dp（2 个汉字 16sp = 32dp + 左右各 16dp 内边距）、间距 8dp、圆角 18dp（半高）。
      文字色由 res/color/selector_nav_text 控制（聚焦黑 / 其余白）。
    -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/navButtons"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/navHome"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_nav_button"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/home_nav_home"
            android:textColor="@color/selector_nav_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />




        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/navVod"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_nav_button"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="64dp"
            android:nextFocusDown="@id/recycler"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/home_vod"
            android:textColor="@color/selector_nav_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 中间撑开：把右侧组推到屏幕右缘；自身不可聚焦 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:focusable="false" />

    <!-- 右侧组：站源下拉入口 → 时钟（设置已并入导航「我的」，搜索已并入左侧放大镜圆钮） -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/rightGroup"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          站源下拉入口：未选中状态没有胶囊容器（selector_site_entry 常态全透明），
          只有站源名 + 三角；聚焦时才出现半透明胶囊 + 白描边作为焦点反馈。
          站源名 16sp，左右内边距 10dp、右距 8dp；三角 16×8dp、与文字间距 12dp。
          行高 36dp（与导航胶囊一致）。
        -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/siteEntry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_site_entry"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/recycler"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- 站源名：与右侧时钟同一套字体样式（14sp 常规、关闭字体内边距），仅作状态入口不抢焦点 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/siteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:textColor="@color/selector_site_entry_content"
                android:textSize="@dimen/text_label"
                tools:text="配置|中心" />

            <!-- 细线 chevron：与 14sp 站源名同高协调，间距 8dp；展开时旋转 180° 指向上 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/siteArrow"
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_site_chevron"
                android:tint="@color/selector_site_entry_content" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!--
          设置入口：替代原导航胶囊「我的」，白色线条矢量图标（ic_setting_line，由 24×24 SVG
          转 VectorDrawable），位于时间左侧（与时间互换位置，时间回到顶栏最右）。

          容器 36dp（toolbar_setting_box）= 搜索圆钮直径：聚焦白底 selector_setting_bg
          与搜索按钮选中态背景完全一致（同直径正圆）；内边距 (36−26.4)/2 = 4.8dp，
          让矢量图标的可视边长 = 26.4dp = 原 22dp × 120%，1:1 + fitCenter 不拉伸。
          rightGroup 的 center_vertical 保证它与 22dp 的时钟共用同一条中心线
          （不再要求等高等宽，图标上下各比时钟多出 7dp）。
          焦点反馈仍是反色：白色圆底 + selector_setting_tint 黑线；常态透明底白线。
        -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/settingEntry"
            android:layout_width="@dimen/toolbar_setting_box"
            android:layout_height="@dimen/toolbar_setting_box"
            android:background="@drawable/selector_setting_bg"
            android:clickable="true"
            android:contentDescription="@string/home_setting"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/recycler"
            android:padding="4.8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_setting_line"
            android:tint="@color/selector_setting_tint" />

        <!-- 时间：HH:mm 无秒，18sp 加粗（全局时钟统一口径），位于顶栏最右。
             固定行高 22dp；设置图标容器比它大，靠 rightGroup 的 center_vertical 共用中心线。 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_time_row"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold"
            tools:text="21:36" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
