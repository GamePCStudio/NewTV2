<?xml version="1.0" encoding="utf-8"?>
<!--
  圆角 outline 背景：卡片底色 + 1px 内描边 rgba(255,255,255,0.14)。
  作为堆叠按钮容器 / 示例页的圆角底，四角之外保持完全透明。
  真正的海报圆角由 RoundedPosterView 的 BitmapShader 绘制，不依赖本背景。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/stack_card_bg" />
    <stroke
        android:width="@dimen/stack_stroke_width"
        android:color="@color/stack_inner_stroke" />
    <corners android:radius="@dimen/stack_focus_ring_radius" />

</shape>
